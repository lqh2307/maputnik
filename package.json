{
  "name": "maputnik",
  "description": "A MapLibre GL visual style editor",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Huy Le <lqh23072000@gmail.com>",
  "keywords": [
    "editor"
  ],
  "private": true,
  "type": "module",
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "scripts": {
    "start": "cross-env GENERATE_SOURCEMAP=false NODE_OPTIONS=--no-deprecation CHOKIDAR_USEPOLLING=true WATCHPACK_POLLING=true craco start",
    "dev": "cross-env GENERATE_SOURCEMAP=false NODE_OPTIONS=--no-deprecation CHOKIDAR_USEPOLLING=true WATCHPACK_POLLING=true craco start",
    "build": "cross-env GENERATE_SOURCEMAP=false NODE_OPTIONS=--no-deprecation craco build",
    "i18n:extract": "npx i18next-cli extract",
    "lint": "eslint \"src/**/*.{json,js,ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{json,js,ts,tsx,css}\"",
    "newest": "npx npm-check-updates -u && npx json -I -f package.json -e \"if(this.dependencies){Object.keys(this.dependencies).forEach(k=>this.dependencies[k]=this.dependencies[k].replace(/^[~^]/,''))} if(this.devDependencies){Object.keys(this.devDependencies).forEach(k=>this.devDependencies[k]=this.devDependencies[k].replace(/^[~^]/,''))}\"",
    "prepare": "husky",
    "lint-css": "stylelint \"src/styles/*.scss\"",
    "sort-styles": "jq 'sort_by(.id)' src/config/styles.json > tmp.json && mv tmp.json src/config/styles.json"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@maplibre/maplibre-gl-geocoder": "^1.9.4",
    "@maplibre/maplibre-gl-inspect": "^1.8.2",
    "@maplibre/maplibre-gl-style-spec": "^26.2.1",
    "array-move": "^4.0.0",
    "buffer": "^6.0.3",
    "classnames": "^2.5.1",
    "codemirror": "^6.0.2",
    "color": "^5.0.3",
    "downshift": "^9.4.0",
    "file-saver": "^2.0.5",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "json-stringify-pretty-compact": "^4.0.0",
    "json-to-ast": "^2.1.0",
    "lodash": "^4.18.1",
    "lodash.capitalize": "^4.2.1",
    "lodash.clamp": "^4.0.3",
    "lodash.clonedeep": "^4.5.0",
    "lodash.get": "^4.4.2",
    "lodash.isequal": "^4.5.0",
    "lodash.throttle": "^4.1.1",
    "maplibre-gl": "^5.24.0",
    "ol": "^10.10.0",
    "ol-mapbox-style": "^13.4.2",
    "pmtiles": "^4.4.1",
    "react": "^19.2.7",
    "react-accessible-accordion": "^5.0.1",
    "react-aria-menubutton": "^8.0.0",
    "react-aria-modal": "^5.0.2",
    "react-collapse": "^5.1.1",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "reconnecting-websocket": "^4.4.0",
    "slugify": "^1.6.9",
    "string-hash": "^1.1.3"
  },
  "lint-staged": {
    "*.{json,js,ts,tsx,css}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/plugin-transform-member-expression-literals": "8.0.1",
    "@craco/craco": "7.1.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/codemirror": "^5.60.18",
    "@types/color": "^4.2.1",
    "@types/cors": "^2.8.19",
    "@types/file-saver": "^2.0.7",
    "@types/geojson": "^7946.0.16",
    "@types/json-to-ast": "^2.1.4",
    "@types/lodash.capitalize": "^4.2.9",
    "@types/lodash.clamp": "^4.0.9",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "26.1.2",
    "@types/randomcolor": "^0.5.9",
    "@types/react": "^19.2.17",
    "@types/react-aria-menubutton": "^6.2.14",
    "@types/react-aria-modal": "^5.0.0",
    "@types/react-collapse": "^5.0.4",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.3",
    "@types/string-hash": "^1.1.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "cross-env": "10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "9.1.7",
    "i18next-cli": "^1.67.4",
    "lint-staged": "17.3.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-scss": "^7.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "react-scripts": "5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
