{
  "compilerOptions": {
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "module": "es2022",
    "outDir": "./build",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "./build"]
}
